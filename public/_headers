# Cloudflare serves these with every file of the built app (wrangler.jsonc). Python runs in a worker
# that shares memory with the page, which needs cross-origin isolation; worker/index.ts sets the same
# on the pages it serves.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=31536000, immutable
