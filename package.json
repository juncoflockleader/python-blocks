{
  "name": "python-blocks",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "pnpm assets && vite --host 127.0.0.1",
    "build": "pnpm assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm test:python && pnpm build"
  },
  "dependencies": {
    "@blockly/block-shareable-procedures": "13.3.0",
    "blockly": "13.3.0",
    "fflate": "0.8.3",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
