# /etc/python-blocks.env on the Linode box (owner root, group pyblocks, mode 640).
# PROXY_SECRET is the Worker's secret too (wrangler secret put PROXY_SECRET); keep it out of the repository.
PORT=8788
HOST=127.0.0.1
DATA_DIR=/var/lib/python-blocks
API_ONLY=1
SITE_ORIGIN=https://pythonblocks.org
COOKIE_SECURE=true
TRUST_PROXY=1
NODE_ENV=production
NODE_NO_WARNINGS=1
PROXY_SECRET=
