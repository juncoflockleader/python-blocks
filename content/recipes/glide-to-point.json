                "fields": {
                  "VALUE": "150"
                }
              }
            },
            "Y": {
              "shadow": {
                "type": "py_number",
                "fields": {
                  "VALUE": "80"
                }
              }
            }
          }
        },
        {
          "type": "scene_glide",
          "inputs": {
            "SPRITE": {
