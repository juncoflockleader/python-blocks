        }
      ]
    },
    {
      "handler": {
        "kind": "countdown"
      },
      "stack": [
        {
          "type": "game_finish",
          "fields": {
            "WON": "TRUE"
          },
          "inputs": {
            "TEXT": {
              "shadow": {
                "type": "text",
                "fields": {
                  "TEXT": "You survived!"
                }
              }
            }
          }
        }
      ]
    }
