  "velocity",
  "bounce",
  "nested loops",
  "clone scripts",
  "lives",
  "win condition"
 ],
 "learn": [
  "give a sprite velocity, a speed with a direction, and make it bounce off the walls",
  "build a wall with loops: one repeat for a row, and a repeat around it for the rows",
  "write one script that every brick runs for itself, because clones share their sprite’s scripts",
  "decide who wins: 3 rows of 8 make 24 bricks to break"
 ],
